# Base de datos. En desarrollo usamos SQLite local (archivo).
# En producción (Turso) usá: libsql://tu-db.turso.io
DATABASE_URL="file:./dev.db"

# Solo para Turso. Dejalo vacío en desarrollo local.
DATABASE_AUTH_TOKEN=""

# Secreto con el que se firman los tokens de sesión (JWT HS256).
# Generalo con: openssl rand -base64 32
SESSION_SECRET="cambiame-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres"

# Datos del comercio para el comprobante (RF-V7).
NOMBRE_COMERCIO="Ferretería El Martillo"
DIRECCION_COMERCIO="Av. Principal 1234, San Miguel de Tucumán"
TELEFONO_COMERCIO="381 455-0000"
CUIT_COMERCIO="30-12345678-9"
