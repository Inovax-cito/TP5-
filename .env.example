# Base de datos: SQLite local en desarrollo. En producción, la URL libsql://… de Turso.
DATABASE_URL=file:local.db
# Token de Turso (vacío en desarrollo).
DATABASE_AUTH_TOKEN=
# Secreto para firmar la cookie de sesión. Cambialo en producción (openssl rand -base64 32).
SESSION_SECRET=cambiar-este-secreto-de-desarrollo-por-uno-largo-y-aleatorio
